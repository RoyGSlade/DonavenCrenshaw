{
    "name": "source-arcanum-site",
    "version": "1.0.0",
    "description": "Static site for Source Arcanum",
    "type": "module",
    "scripts": {
        "dev": "node scripts/dev.mjs",
        "build": "node scripts/build.mjs",
        "validate": "node scripts/validateData.js",
        "check:privacy": "node scripts/checkPrivacy.mjs",
        "security-scan": "grep -rnE \"(api_key|ghp_|sk-|secret|password)\" src/ scripts/ content/ --exclude-dir=node_modules || exit 0"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "main": "index.js",
    "directories": {
        "doc": "docs"
    },
    "dependencies": {
        "chokidar": "^5.0.0",
        "ejs": "^6.0.1",
        "fs-extra": "^11.3.3",
        "gray-matter": "^4.0.3",
        "marked": "^17.0.3"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/RoyGSlade/SourceArcanum.git"
    },
    "bugs": {
        "url": "https://github.com/RoyGSlade/SourceArcanum/issues"
    },
    "homepage": "https://github.com/RoyGSlade/SourceArcanum#readme"
}
