{
    "name": "donaven-crenshaw-site",
    "version": "1.0.0",
    "description": "Donaven Crenshaw's static public workspace for software, systems work, and Infinite Ages.",
    "type": "module",
    "scripts": {
        "dev": "node scripts/dev.mjs",
        "build": "node scripts/build.mjs",
        "validate": "node scripts/validateData.js",
        "verify:site": "node scripts/verifySite.mjs",
        "verify": "npm run validate && SITE_BASE=/ npm run build && npm run verify:site && npm run check:privacy && npm run security-scan",
        "check:privacy": "node scripts/checkPrivacy.mjs",
        "security-scan": "! rg -n -i '(api[_-]?key\\s*[:=]|ghp_[a-z0-9]+|\\bsk-[a-z0-9]{8,}|password\\s*[:=])' src content scripts data .github"
    },
    "keywords": [],
    "author": "Donaven Crenshaw",
    "license": "MIT",
    "main": "index.js",
    "directories": {
        "doc": "docs"
    },
    "dependencies": {
        "chokidar": "^5.0.0",
        "ejs": "^6.0.1",
        "fs-extra": "^11.4.0",
        "gray-matter": "^4.0.3",
        "marked": "^17.0.3"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/RoyGSlade/SourceArcanum.git"
    },
    "bugs": {
        "url": "https://github.com/RoyGSlade/SourceArcanum/issues"
    },
    "homepage": "https://github.com/RoyGSlade/SourceArcanum#readme"
}
