{
    "name": "source-arcanum-site",
    "version": "1.0.0",
    "description": "Static site for Source Arcanum",
    "type": "module",
    "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "validate": "node scripts/validateData.js",
    "check:privacy": "! rg -n -i '(google-analytics|googletagmanager|segment\\.io|mixpanel|plausible\\.io|hotjar)' src content scripts data .github",
        "security-scan": "grep -rnE \"(api_key|ghp_|sk-|secret|password)\" src/ scripts/ content/ --exclude-dir=node_modules || exit 0"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "gray-matter": "^4.0.3",
        "marked": "^17.0.3"
    },
    "main": "index.js",
    "directories": {
        "doc": "docs"
    },
    "dependencies": {
        "argparse": "^1.0.10",
        "chokidar": "^5.0.0",
        "ejs": "^4.0.1",
        "esprima": "^4.0.1",
        "extend-shallow": "^2.0.1",
        "fs-extra": "^11.3.3",
        "is-extendable": "^0.1.1",
        "js-yaml": "^3.14.2",
        "kind-of": "^6.0.3",
        "section-matter": "^1.0.0",
        "sprintf-js": "^1.0.3",
        "strip-bom-string": "^1.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/RoyGSlade/SourceArcanum.git"
    },
    "bugs": {
        "url": "https://github.com/RoyGSlade/SourceArcanum/issues"
    },
    "homepage": "https://github.com/RoyGSlade/SourceArcanum#readme"
}
