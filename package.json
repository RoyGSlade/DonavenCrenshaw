{
    "name": "donaven-crenshaw-site",
    "version": "1.0.0",
    "description": "Donaven Crenshaw's static public workspace for software, systems work, and Infinite Ages.",
    "type": "module",
    "scripts": {
        "dev:stardust": "node scripts/preview-stardust.mjs",
        "dev:dogfight": "node scripts/serve-stardust-dogfight.mjs",
        "build:stardust": "node scripts/build-stardust.mjs",
        "test:stardust": "node --test tests/stardust-*.test.mjs",
        "assets:3d": "node tools/3d/build.mjs",
        "assets:3d:incoming": "node tools/3d/build.mjs --incoming",
        "assets:3d:manifest": "node tools/3d/build.mjs --no-blender",
        "assets:3d:check": "node tools/3d/build.mjs --check",
        "dev": "node scripts/dev.mjs",
        "build": "node scripts/build.mjs",
        "validate": "node scripts/validateData.js",
        "validate:projects": "node scripts/validateProjectSource.mjs --source fixtures/projects/example-project",
        "test:projects": "node --test tests/projectSources.test.mjs",
        "test:site": "node --test tests/site-*.test.mjs",
        "verify:site": "node scripts/verifySite.mjs",
        "verify": "npm run validate && npm run test:projects && npm run test:site && npm run validate:projects && SITE_BASE=/ npm run build && npm run verify:site && npm run check:privacy && npm run security-scan",
        "check:privacy": "node scripts/checkPrivacy.mjs",
        "security-scan": "! rg -n -i '(api[_-]?key\\s*[:=]|ghp_[a-z0-9]+|\\bsk-[a-z0-9]{8,}|password\\s*[:=])' src content scripts data .github"
    },
    "keywords": [],
    "author": "Donaven Crenshaw",
    "license": "MIT",
    "main": "index.js",
    "directories": {
        "doc": "docs"
    },
    "dependencies": {
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1",
        "chokidar": "^5.0.0",
        "ejs": "^6.0.1",
        "fs-extra": "^11.4.0",
        "gray-matter": "^4.0.3",
        "marked": "^17.0.3",
        "sanitize-html": "^2.17.6",
        "ws": "8.21.3"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/RoyGSlade/DonavenCrenshaw.git"
    },
    "bugs": {
        "url": "https://github.com/RoyGSlade/DonavenCrenshaw/issues"
    },
    "homepage": "https://github.com/RoyGSlade/DonavenCrenshaw#readme",
    "devDependencies": {
        "@gltf-transform/core": "4.5.1",
        "@gltf-transform/extensions": "4.5.1",
        "@gltf-transform/functions": "4.5.1",
        "three": "0.186.0"
    }
}
