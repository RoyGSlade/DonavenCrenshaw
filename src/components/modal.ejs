<div id="overlay" class="overlay">
    <div class="dossier">
        <div class="dossier-header">
            <div>
                <h2 id="modal-title">Project details</h2>
                <span id="modal-status" class="mono">Status not provided</span>
            </div>
            <button class="close-btn" type="button" onclick="closeModal()" aria-label="Close project details">&times;</button>
        </div>
        <div class="dossier-body">
            <div class="dossier-sidebar">
                <h3 class="mono">Project facts</h3>
                <div id="modal-stats"></div>
                <h3 class="mono">Links</h3>
                <div id="modal-links"></div>
            </div>
            <div class="dossier-main">
                <div id="modal-desc" class="reading-text"></div>
                <div class="divider"></div>
                <h3 class="mono">Roadmap</h3>
                <div id="modal-roadmap"></div>
            </div>
        </div>
    </div>
</div>
