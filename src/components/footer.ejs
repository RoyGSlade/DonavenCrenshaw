<footer class="site-footer">
    <div class="footer-content">
        <p class="footer-name mono"><%= site.name %></p>
        <nav class="footer-links mono" aria-label="Footer navigation">
            <a href="<%= siteLink('projects') %>">Projects</a>
            <a href="<%= siteLink('support') %>">Support</a>
            <a href="<%= siteLink('about') %>">About</a>
            <a href="<%= siteLink('contact') %>">Contact</a>
            <a href="<%= siteLink('privacy') %>">Privacy</a>
            <a href="<%= siteLink('licenses') %>">Licenses</a>
            <% if (site.social && site.social.github) { %><a href="<%= site.social.github %>" target="_blank" rel="noopener noreferrer">GitHub</a><% } %>
        </nav>
    </div>
</footer>
