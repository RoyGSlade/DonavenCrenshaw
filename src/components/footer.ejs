        <div class="footer-brand">
            <h3 class="mono" style="color: var(--accent-gold); margin-bottom: 0.35rem;"><%= site.name.toUpperCase() %></h3>
            <p style="color: var(--text-muted); font-size: 0.9rem;">Building practical, private, and creative software.</p>
            <p class="mono" style="color: var(--tech-cyan); font-size: 0.68rem; margin-top: 0.7rem;"><%= site.studio.name %> · Independent local-first software lab.</p>
