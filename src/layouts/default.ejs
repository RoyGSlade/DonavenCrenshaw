<!DOCTYPE html>
<html lang="en">
<%- components.head %>
<body class="site-shell skin-<%= page.skin %>" data-branch="<%= page.branch %>">
    <div class="page-light light-source parallax" aria-hidden="true"></div>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <%- components.nav %>
    <div class="content-wrapper">
        <main id="main-content" class="page-shell" tabindex="-1">
            <% if (frontmatter.hero_title) { %><%- include('hero', { frontmatter }) %><% } %>
            <div class="container page-content">
                <% if (!frontmatter.hero_title && frontmatter.title) { %><h1 class="section-title"><%= frontmatter.title %></h1><% } %>
                <% if (frontmatter.date || frontmatter.status) { %>
                    <div class="mono page-meta">
                        <% if (frontmatter.date) { %><span>Updated <%= frontmatter.date %></span><% } %>
                        <% if (frontmatter.status) { %><span>Status: <%= frontmatter.status %></span><% } %>
                    </div>
                <% } %>
                <div class="page-copy"><%- content %></div>
            </div>
        </main>
        <%- components.footer %>
    </div>
    <script src="<%= siteRoot %>scripts/script.js"></script>
    <script src="<%= siteRoot %>scripts/light-engine.js"></script>
    <script src="<%= siteRoot %>scripts/smoke.js"></script>
</body>
</html>
