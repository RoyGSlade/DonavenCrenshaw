<!DOCTYPE html>
<html lang="en">
<%- components.head %>
<body class="site-shell skin-<%= page.skin %> account-page" data-branch="<%= page.branch %>">
    <div class="page-light light-source parallax" aria-hidden="true"></div>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <%- components.nav %>
    <div class="content-wrapper">
        <main id="main-content" class="page-shell" tabindex="-1">
            <div class="container page-content acct" data-account-app data-view="loading">
                <header class="acct-head">
                    <p class="acct-eyebrow mono">Account · <%= new URL(hubUrl).host %></p>
                    <h1 class="section-title acct-title" data-acct-title>Your account</h1>
                    <p class="acct-lede" data-acct-lede>One account for the games and tools on this site. Sign in and every Stardust circuit you finish goes on the leaderboard.</p>
                </header>

                <p><a href="<%= siteRoot %>voting/">Development votes</a> · One equal vote per account in each poll I open.</p>
                <p><a href="<%= siteLink('privacy') %>#accounts">Privacy and account data</a></p>

                <noscript><div class="noir-card acct-card"><p>Accounts need JavaScript. Everything else on this site works without it.</p></div></noscript>

                <div class="acct-state noir-card" data-view-only="loading" role="status"><span class="acct-pulse" aria-hidden="true"></span><p class="mono">Checking your session…</p></div>

                <div class="acct-state noir-card" data-view-only="offline" role="status" hidden>
                    <h2>The hub is resting</h2>
                    <p>Accounts run on a small server at home, and it isn't answering right now. Nothing is lost; try again in a few minutes.</p>
                    <button class="btn-noir" type="button" data-acct-retry>Try again</button>
                </div>

                <!-- Signed out -->
                <div class="acct-guest" data-view-only="guest" hidden>
                    <%# A friend invite (?friend=<username>) waits here until the visitor signs in; the page then asks again. %>
                    <section class="noir-card noir-card--lit acct-card acct-invite" aria-labelledby="acct-invite-guest-title" data-acct-invite-guest hidden>
                        <h2 id="acct-invite-guest-title" class="acct-card-title mono">Friend invite</h2>
                        <p class="acct-invite-q" data-acct-invite-guest-text></p>
                        <p>Sign in or create an account first. You’ll come straight back to this invite, and nothing is sent until you say so.</p>
                        <div class="acct-invite-actions">
                            <button class="btn-noir btn-noir--solid" type="button" data-acct-invite-tab="signin">Sign in</button>
                            <button class="btn-noir" type="button" data-acct-invite-tab="signup">Create account</button>
                        </div>
                    </section>

                    <section class="noir-card noir-card--lit acct-card acct-auth" aria-labelledby="acct-auth-title">
                        <h2 id="acct-auth-title" class="visually-hidden">Sign in or create an account</h2>
                        <div class="acct-tabs mono" role="tablist" aria-label="Account">
                            <button type="button" role="tab" id="acct-tab-signin" aria-controls="acct-signin" aria-selected="true" data-acct-tab="signin">Sign in</button>
                            <button type="button" role="tab" id="acct-tab-signup" aria-controls="acct-signup" aria-selected="false" tabindex="-1" data-acct-tab="signup">Create account</button>
                        </div>

                        <form id="acct-signin" class="acct-form" role="tabpanel" aria-labelledby="acct-tab-signin" data-acct-form="signin" novalidate>
                            <label>Email<input name="email" type="email" autocomplete="email" required maxlength="254"></label>
                            <label>Password<input name="password" type="password" autocomplete="current-password" required maxlength="200"></label>
                            <p class="acct-status" role="alert" data-acct-status></p>
                            <button class="btn-noir btn-noir--solid" type="submit">Sign in</button>
                            <p class="acct-fine">Forgot your password? There's no reset email yet. <a href="contact/">Get in touch</a> and it can be reset by hand.</p>
                        </form>

                        <form id="acct-signup" class="acct-form" role="tabpanel" aria-labelledby="acct-tab-signup" data-acct-form="signup" novalidate hidden>
                            <label>Email<input name="email" type="email" autocomplete="email" required maxlength="254"></label>
                            <label>Username<input name="username" type="text" autocomplete="username" required minlength="3" maxlength="20" pattern="[A-Za-z0-9_\-]{3,20}" spellcheck="false" aria-describedby="acct-username-hint"></label>
                            <p class="acct-hint" id="acct-username-hint">3–20 letters, numbers, - or _. Shown on leaderboards.</p>
                            <label>Password<input name="password" type="password" autocomplete="new-password" required minlength="10" maxlength="200" aria-describedby="acct-password-hint"></label>
                            <p class="acct-hint" id="acct-password-hint">At least 10 characters, with a letter and a number.</p>
                            <p class="acct-status" role="alert" data-acct-status></p>
                            <button class="btn-noir btn-noir--solid" type="submit">Create account</button>
                            <p class="acct-fine">By creating an account you agree to the <a href="<%= siteLink('privacy') %>">privacy notice</a>. Opt-in updates only. No forced tracking.</p>
                        </form>
                    </section>

                    <aside class="acct-aside" aria-label="About accounts">
                        <div class="noir-card acct-card">
                            <h2 class="acct-card-title mono">What it's for</h2>
                            <ul class="acct-list">
                                <li><strong>Your name on the boards.</strong> Only signed-in runs count. Every finished circuit, and every full run of all five, is saved with its rank.</li>
                                <li><strong>Dogfight wins.</strong> When you and your opponent are both signed in, every win counts as a casual account record. New Dogfight titles are paused until combat can be verified. Existing titles remain yours.</li>
                                <li><strong>A profile.</strong> A display name and a short bio, nothing more.</li>
                            </ul>
                        </div>
                        <div class="noir-card acct-card">
                            <h2 class="acct-card-title mono">What's kept</h2>
                            <p>Your email, username, a salted password hash, your profile, your Stardust times and your Dogfight record, on a server in Northern Nevada. Delete the account and it's gone. <a href="<%= siteLink('privacy') %>#accounts">Details</a>.</p>
                        </div>
                    </aside>
                </div>

                <!-- Signed in -->
                <div class="acct-member" data-view-only="member" hidden>
                    <section class="noir-card noir-card--lit acct-card acct-id" aria-label="Profile">
                        <span class="acct-monogram" aria-hidden="true" data-acct-monogram></span>
                        <div class="acct-id-copy">
                            <p class="acct-id-name" data-acct-name></p>
                            <p class="acct-id-title" data-acct-title-chip hidden></p>
                            <p class="acct-id-meta mono"><span data-acct-username></span> · <span data-acct-since></span></p>
                            <p class="acct-id-bio" data-acct-bio></p>
                        </div>
                        <div class="acct-id-actions">
                            <a class="btn-noir" href="u/" data-acct-profile-link>View my public profile</a>
                            <button class="btn-noir" type="button" data-acct-signout>Sign out</button>
                        </div>
                    </section>

                    <section class="noir-card noir-card--lit acct-card acct-invite" aria-labelledby="acct-invite-title" data-acct-invite hidden>
                        <h2 id="acct-invite-title" class="acct-card-title mono">Friend invite</h2>
                        <p class="acct-invite-q" data-acct-invite-text></p>
                        <div class="acct-invite-actions" data-acct-invite-actions></div>
                        <p class="acct-status" role="status" data-acct-status="invite"></p>
                    </section>

                    <section class="noir-card acct-card acct-stats" aria-labelledby="acct-stats-title">
                        <h2 id="acct-stats-title" class="acct-card-title mono">Your stats</h2>
                        <dl class="acct-stat-grid">
                            <div class="acct-stat"><dt class="mono">Fastest Stardust run</dt><dd data-acct-stat="full">—</dd><p class="acct-stat-sub" data-acct-stat-sub="full">All five circuits</p></div>
                            <div class="acct-stat"><dt class="mono">Fastest circuit</dt><dd data-acct-stat="circuit">—</dd><p class="acct-stat-sub" data-acct-stat-sub="circuit">Any single circuit</p></div>
                            <div class="acct-stat"><dt class="mono">Dogfight wins</dt><dd data-acct-stat="wins">—</dd><p class="acct-stat-sub" data-acct-stat-sub="wins">Against signed-in pilots</p></div>
                        </dl>
                    </section>

                    <%# Avatar, title and profile visibility: how the pilot shows up on boards, comments and /u/. %>
                    <section class="noir-card noir-card--lit acct-card acct-pilot" id="pilot-card" aria-labelledby="acct-pilot-title">
                        <div class="acct-card-head"><h2 id="acct-pilot-title" class="acct-card-title mono">Pilot card</h2></div>
                        <p class="acct-hint acct-pilot-hint">How you appear on leaderboards, in comments and on your profile.</p>
                        <div class="acct-pilot-grid">
                            <fieldset class="acct-fieldset acct-avatars">
                                <legend class="acct-sub-title mono">Avatar</legend>
                                <div class="acct-avatar-grid" data-acct-avatar-grid></div>
                                <p class="acct-status" role="status" data-acct-status="avatar"></p>
                            </fieldset>
                            <div class="acct-pilot-side">
                                <fieldset class="acct-fieldset acct-titles">
                                    <legend class="acct-sub-title mono">Title</legend>
                                    <div class="acct-title-list" data-acct-title-list></div>
                                    <p class="acct-hint" data-acct-titles-empty hidden>No titles yet. Win a weekly, place on a board or finish a challenge and they turn up here.</p>
                                    <p class="acct-status" role="status" data-acct-status="title"></p>
                                    <details class="acct-locked" data-acct-locked hidden>
                                        <summary class="mono">Locked titles <span data-acct-locked-count></span></summary>
                                        <ul class="acct-locked-list" data-acct-locked-list></ul>
                                    </details>
                                </fieldset>
                            </div>
                        </div>
                    </section>

                    <%# The equipped ship, drawn from its appearance by the game's own renderer (scripts/ship-ui.js). No pictures are stored or uploaded. %>
                    <section class="noir-card acct-card acct-ship" id="ship" aria-labelledby="acct-ship-title">
                        <div class="acct-card-head"><h2 id="acct-ship-title" class="acct-card-title mono">Your ship</h2><a class="acct-link mono" data-acct-play-link href="games/stardust/">Customize in the game →</a></div>
                        <div class="acct-ship-body">
                            <div class="ship-slot" data-acct-ship></div>
                            <p class="acct-hint acct-ship-hint" data-acct-ship-hint>The ship you fly in Stardust. Change its parts and paint in the game's garage; it shows here, on your public profile if you choose, and as a small tag on leaderboard rows.</p>
                        </div>
                        <p class="acct-status" role="status" data-acct-status="ship"></p>
                    </section>

                    <section class="noir-card acct-card" id="ship-designs" aria-labelledby="acct-livery-title">
                        <div class="acct-card-head"><h2 id="acct-livery-title" class="acct-card-title mono">Your ship designs</h2><a class="acct-link mono" data-acct-livery-link href="games/stardust/">Creator profile →</a></div>
                        <p class="acct-hint">Published liveries belong to your profile. Other pilots can download their editable layers and leave comments.</p>
                        <div class="acct-liveries" data-acct-liveries></div>
                        <p class="acct-empty" data-acct-livery-status role="status" hidden></p>
                    </section>

                    <%# What other pilots see on /u/: the master switch, then one switch per section. Each saves on its own. %>
                    <section class="noir-card acct-card acct-visibility" id="public-profile" aria-labelledby="acct-visibility-title">
                        <div class="acct-card-head"><h2 id="acct-visibility-title" class="acct-card-title mono">Public profile</h2><a class="acct-link mono" href="u/" data-acct-profile-link>View my public profile →</a></div>
                        <div class="acct-public">
                            <label class="acct-switch"><input type="checkbox" role="switch" data-acct-public aria-describedby="acct-public-hint"><span class="acct-switch-track" aria-hidden="true"></span><span class="acct-switch-label">Public profile</span></label>
                            <p class="acct-hint" id="acct-public-hint">On: anyone with your profile link sees the sections you leave on below. Off: only your name, avatar, title and, if you leave it on, your weekly placements.</p>
                            <p class="acct-status" role="status" data-acct-status="public"></p>
                        </div>
                        <fieldset class="acct-fieldset acct-show" data-acct-show>
                            <legend class="acct-sub-title mono">What your profile shows</legend>
                            <p class="acct-hint acct-show-lock" id="acct-show-lock" data-acct-show-lock hidden>Your profile is private, so these are switched off for everyone else. Turn on Public profile to choose. Event results and Flight settings are the exceptions: they follow their own switch either way.</p>
                            <ul class="acct-show-list">
                                <% [['bio', 'Bio', 'The short bio from your profile.'],
                                    ['titles', 'Titles', 'Every title you have earned.'],
                                    ['bests', 'Best times', 'Your best time and rank on each Stardust board.'],
                                    ['dogfight', 'Dogfight record', 'Your Dogfight wins and losses.'],
                                    ['events', 'Event results', 'Weekly placements. These show even while your profile is private.'],
                                    ['ship', 'Ship', 'The ship you have equipped, drawn from the garage.'],
                                    ['devices', 'Device badges', 'A small icon on leaderboard rows for the device and controls you flew with.'],
                                    ['settings', 'Flight settings', 'Let others copy my flight settings from the leaderboards. Off until you switch it on. Shares your camera, controls, key and controller bindings and HUD layout, nothing about your account. Works even while your profile is private.']].forEach(([key, label, hint]) => { %>
                                <li class="acct-show-row" data-acct-show-row="<%= key %>">
                                    <label class="acct-switch"><input type="checkbox" role="switch" data-acct-show-key="<%= key %>" aria-describedby="acct-show-<%= key %>-hint"><span class="acct-switch-track" aria-hidden="true"></span><span class="acct-switch-label"><%= label %></span></label>
                                    <p class="acct-hint" id="acct-show-<%= key %>-hint"><%= hint %></p>
                                </li>
                                <% }) %>
                            </ul>
                            <p class="acct-status" role="status" data-acct-status="show"></p>
                        </fieldset>
                    </section>

                    <%# Discord: link the account so the bot can give Stardust roles on the owner's server. The card stays hidden unless the hub says Discord is switched on (scripts/account.js loadDiscord). %>
                    <section class="noir-card acct-card acct-discord" id="discord" aria-labelledby="acct-discord-title" data-acct-discord hidden>
                        <div class="acct-card-head"><h2 id="acct-discord-title" class="acct-card-title mono">Discord</h2><a class="acct-link mono" href="https://discord.gg/qjntnnd9cD" rel="noopener noreferrer" data-acct-discord-join>Join the Discord →</a></div>
                        <p class="acct-hint acct-discord-hint">Link your Discord account and a bot on Donaven's server gives you Stardust roles. It only asks Discord who you are: no messages, no servers, no email. Unlink any time and the roles come off.</p>
                        <ul class="acct-list acct-discord-roles">
                            <li><strong>Pilot.</strong> Finish any Stardust run while signed in.</li>
                            <li><strong>Weekly Finisher.</strong> Set a time on the weekly that is live now.</li>
                            <li><strong>Podium and Weekly Champion.</strong> Place top three, or first, with a verified or reviewed result on the last weekly. Provisional times cannot grant new competitive roles. Staff dev times never place.</li>
                            <li><strong>Needle, Manta, Wisp or Courier Pilot.</strong> The family of your equipped ship, only while your profile shows your ship.</li>
                        </ul>
                        <div class="acct-discord-state">
                            <p class="acct-discord-linked" data-acct-discord-linked hidden>Linked as <strong data-acct-discord-name></strong></p>
                            <div class="acct-discord-actions" data-acct-discord-actions>
                                <a class="btn-noir btn-noir--solid" href="#" data-acct-discord-link>Link Discord</a>
                                <button class="btn-noir" type="button" data-acct-discord-unlink hidden>Unlink</button>
                            </div>
                        </div>
                        <p class="acct-status" role="status" data-acct-status="discord"></p>
                    </section>

                    <div class="acct-grid">
                        <section class="noir-card acct-card acct-stardust" aria-labelledby="acct-sd-title">
                            <div class="acct-card-head"><h2 id="acct-sd-title" class="acct-card-title mono">Stardust</h2><a class="acct-link mono" href="stardust/">Game page →</a></div>
                            <ol class="acct-bests" data-acct-bests></ol>
                            <p class="acct-empty" data-acct-bests-empty>No saved times yet. <a href="games/stardust/">Fly a circuit</a> while signed in and your best times and ranks show here.</p>
                            <div class="acct-splits" data-acct-splits hidden>
                                <h3 class="acct-sub-title mono">Best full run, circuit by circuit</h3>
                                <dl class="acct-split-list" data-acct-split-list></dl>
                            </div>
                        </section>

                        <section class="noir-card acct-card acct-wide acct-challenges" id="challenges" aria-labelledby="acct-ch-title">
                            <div class="acct-card-head"><h2 id="acct-ch-title" class="acct-card-title mono">Challenges</h2><a class="acct-link mono" href="stardust/#fastest-runs">Leaderboard →</a></div>
                            <p class="acct-hint acct-ch-hint">A challenge is one fixed full run for someone to beat. Send one from the game after a full run; it stays open for 14 days. Times are casual: provisional and checked for plausibility. New account achievements, titles and competitive rewards require gameplay verification or review; local discoveries and puzzles remain playable.</p>
                            <div class="acct-ch-cols">
                                <section aria-labelledby="acct-inbox-title">
                                    <h3 id="acct-inbox-title" class="acct-sub-title mono">Inbox</h3>
                                    <ul class="acct-ch-list" data-acct-ch-list="inbox"></ul>
                                    <p class="acct-empty" data-acct-ch-empty="inbox">Nothing yet. When a friend sends you a challenge, it lands here.</p>
                                </section>
                                <section aria-labelledby="acct-sent-title">
                                    <h3 id="acct-sent-title" class="acct-sub-title mono">Sent</h3>
                                    <ul class="acct-ch-list" data-acct-ch-list="sent"></ul>
                                    <p class="acct-empty" data-acct-ch-empty="sent">You haven’t sent one yet. Finish a full run in the game and send it to a friend.</p>
                                </section>
                            </div>
                            <p class="acct-status" role="status" data-acct-status="challenges"></p>
                        </section>

                        <section class="noir-card acct-card acct-wide acct-friends" id="friends" aria-labelledby="acct-friends-title">
                            <h2 id="acct-friends-title" class="acct-card-title mono">Friends</h2>
                            <p class="acct-status acct-friends-status" role="status" data-acct-status="friends"></p>
                            <div class="acct-friends-grid">
                                <div class="acct-friends-lists">
                                    <section aria-labelledby="acct-fr-in-title" data-acct-fr-group="incoming" hidden>
                                        <h3 id="acct-fr-in-title" class="acct-sub-title mono">Asking to be friends</h3>
                                        <ul class="acct-people" data-acct-fr-list="incoming"></ul>
                                    </section>
                                    <section aria-labelledby="acct-fr-title">
                                        <h3 id="acct-fr-title" class="acct-sub-title mono">Your friends</h3>
                                        <ul class="acct-people" data-acct-fr-list="friends"></ul>
                                        <p class="acct-empty" data-acct-fr-empty>No friends yet. Send your invite link to someone you race, or add them by username.</p>
                                    </section>
                                    <section aria-labelledby="acct-fr-out-title" data-acct-fr-group="outgoing" hidden>
                                        <h3 id="acct-fr-out-title" class="acct-sub-title mono">Waiting on them</h3>
                                        <ul class="acct-people" data-acct-fr-list="outgoing"></ul>
                                    </section>
                                    <section aria-labelledby="acct-fr-blocked-title" data-acct-fr-group="blocked" hidden>
                                        <h3 id="acct-fr-blocked-title" class="acct-sub-title mono">Blocked</h3>
                                        <ul class="acct-people" data-acct-fr-list="blocked"></ul>
                                    </section>
                                </div>
                                <div class="acct-friends-side">
                                    <form class="acct-form acct-add-friend" data-acct-form="friend" aria-labelledby="acct-add-title" novalidate>
                                        <h3 id="acct-add-title" class="acct-sub-title mono">Add a friend</h3>
                                        <label>Username<input name="username" type="text" autocomplete="off" autocapitalize="none" spellcheck="false" maxlength="300" aria-describedby="acct-add-hint"></label>
                                        <p class="acct-hint" id="acct-add-hint">Their exact username, or paste their invite link.</p>
                                        <p class="acct-status" role="status" data-acct-status></p>
                                        <button class="btn-noir btn-noir--solid" type="submit">Send request</button>
                                    </form>
                                    <div class="acct-invite-share" data-acct-invite-share>
                                        <h3 class="acct-sub-title mono">Your invite link</h3>
                                        <p class="acct-hint">Whoever opens it is asked whether to add you. Nothing is sent for you.</p>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <form class="noir-card acct-card acct-form" id="profile" data-acct-form="profile" aria-labelledby="acct-profile-title" novalidate>
                            <h2 id="acct-profile-title" class="acct-card-title mono">Profile</h2>
                            <label>Display name<input name="displayName" type="text" maxlength="32" autocomplete="nickname" aria-describedby="acct-dn-hint"></label>
                            <p class="acct-hint" id="acct-dn-hint">Shown instead of your username where there's room. Up to 32 characters.</p>
                            <label>Bio<textarea name="bio" maxlength="280" rows="3" data-acct-count="acct-bio-count"></textarea></label>
                            <p class="acct-hint" id="acct-bio-count" aria-live="polite">0 / 280</p>
                            <label><span>Discord username <span class="acct-optional">optional</span></span><input name="discordUsername" type="text" maxlength="37" spellcheck="false"></label>
                            <p class="acct-status" role="status" data-acct-status></p>
                            <button class="btn-noir btn-noir--solid" type="submit">Save profile</button>
                        </form>

                        <form class="noir-card acct-card acct-form" data-acct-form="email" aria-labelledby="acct-email-title" novalidate>
                            <h2 id="acct-email-title" class="acct-card-title mono">Sign-in email</h2>
                            <label>Email<input name="email" type="email" autocomplete="email" required maxlength="254"></label>
                            <label>Current password<input name="currentPassword" type="password" autocomplete="current-password" required></label>
                            <p class="acct-status" role="status" data-acct-status></p>
                            <button class="btn-noir" type="submit">Change email</button>
                        </form>

                        <form class="noir-card acct-card acct-form" data-acct-form="password" aria-labelledby="acct-password-title" novalidate>
                            <h2 id="acct-password-title" class="acct-card-title mono">Password</h2>
                            <label>Current password<input name="currentPassword" type="password" autocomplete="current-password" required></label>
                            <label>New password<input name="newPassword" type="password" autocomplete="new-password" required minlength="10" maxlength="200"></label>
                            <label>Repeat new password<input name="confirmPassword" type="password" autocomplete="new-password" required></label>
                            <p class="acct-hint">Changing it signs out every other device.</p>
                            <p class="acct-status" role="status" data-acct-status></p>
                            <button class="btn-noir" type="submit">Change password</button>
                        </form>

                        <section class="noir-card acct-card" aria-labelledby="acct-sessions-title">
                            <h2 id="acct-sessions-title" class="acct-card-title mono">Sessions</h2>
                            <p>Sign-ins last 30 days on each device. Lost a phone, or signed in somewhere you shouldn't have? End every session at once.</p>
                            <p class="acct-status" role="status" data-acct-status="sessions"></p>
                            <button class="btn-noir" type="button" data-acct-signout-all>Sign out everywhere</button>
                        </section>

                        <form class="noir-card acct-card acct-form acct-danger" data-acct-form="delete" aria-labelledby="acct-delete-title" novalidate>
                            <h2 id="acct-delete-title" class="acct-card-title mono">Delete account</h2>
                            <p>This removes your profile, Stardust times, saves and Dogfight record, straight away. It can't be undone.</p>
                            <label>Type your username to confirm<input name="confirmUsername" type="text" autocomplete="off" spellcheck="false" required></label>
                            <label>Password<input name="password" type="password" autocomplete="current-password" required></label>
                            <p class="acct-status" role="alert" data-acct-status></p>
                            <button class="btn-noir acct-danger-btn" type="submit">Delete my account</button>
                        </form>
                    </div>
                </div>
            </div>
        </main>
        <%- components.footer %>
    </div>
    <script src="<%= siteRoot %>scripts/script.js"></script>
    <script src="<%= siteRoot %>scripts/light-engine.js"></script>
</body>
</html>
