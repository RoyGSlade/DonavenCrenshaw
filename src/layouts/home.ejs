<!DOCTYPE html>
<html lang="en">
<%- components.head %>
<body class="site-shell skin-<%= page.skin %>" data-branch="<%= page.branch %>">
    <div class="page-light light-source parallax" aria-hidden="true"></div>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <%- components.nav %>
    <div class="content-wrapper">
        <main id="main-content" tabindex="-1">
            <% const importedProjects = data.importedProjects || []; %>
            <% const betterFingers = importedProjects.find((item) => item.id === 'betterfingers'); %>
            <% const betterFingersImage = betterFingers && betterFingers.showcase && betterFingers.showcase.slides[0] && betterFingers.showcase.slides[0].media[0]; %>
            <% const betterFingersRelease = betterFingers && betterFingers.project.links.find((link) => link.type === 'documentation'); %>
            <%
              // The lead game owns the first screen. Times come from the committed hub
              // snapshot, so the homepage never waits on (or breaks with) the hub.
              const snap = data.hubSnapshot;
              const podium = snap ? snap.leaderboard.slice(0, 3) : [];
              const two = (n) => String(n).padStart(2, '0');
              const clock = (ms) => {
                const t = Math.max(0, Math.round(Number(ms) || 0));
                return `${Math.floor(t / 60000)}:${two(Math.floor(t / 1000) % 60)}.${two(Math.floor((t % 1000) / 10))}`;
              };
            %>
            <% if (frontmatter.lead_game === 'stardust') { %>
                <section class="container home-stardust-lead" aria-labelledby="stardust-lead-title">
                    <div class="home-stardust-copy">
                        <% const wk = data.weekly; %>
                        <% if (wk) { %>
                        <%# This week's time trial. An <a>, not a <section>: verifySite reads the lead up to its first </section>. %>
                        <a class="home-weekly" href="<%= siteRoot %>stardust/weekly/" data-sd-weekly-banner data-event-id="<%= wk.id %>" data-state="<%= wk.state %>">
                            <span class="home-weekly-tag mono">Weekly</span>
                            <span class="home-weekly-title">Week <%= wk.week %> · <%= wk.title %></span>
                            <span class="home-weekly-status mono" data-sd-weekly-status><%= wk.state === 'upcoming' ? `Opens ${wk.opensText}` : wk.state === 'live' ? `Live · closes ${wk.closesText}` : 'Closed · see the results' %></span>
                            <span class="home-weekly-go" aria-hidden="true">→</span>
                        </a>
                        <% } %>
                        <p class="section-label"><%= frontmatter.hero_kicker %></p>
                        <h1 id="stardust-lead-title"><%= frontmatter.hero_title %></h1>
                        <p class="home-stardust-lede"><%= frontmatter.hero_sub %></p>
                        <div class="home-stardust-actions">
                            <a class="sd-cta home-stardust-play" href="<%= siteRoot %>games/stardust/">PLAY STARDUST</a>
                            <a class="btn-noir" href="<%= siteRoot %>stardust/#fastest-runs">LEADERBOARD</a>
                            <a class="btn-noir" href="<%= siteRoot %>stardust/planetfall/">PLANETFALL PREVIEW</a>
                        </div>
                        <p class="home-stardust-rules">Nothing to install. Guests fly every circuit; only runs flown while <a href="<%= siteRoot %>account/">signed in</a> go on the leaderboard.</p>
                    </div>
                    <div class="home-stardust-side">
                        <a class="home-stardust-visual" href="<%= siteRoot %>stardust/" aria-label="About Stardust">
                            <img src="<%= siteRoot %>assets/images/stardust/alpha-relay-flight.webp" width="1200" height="750" alt="The courier ship boosting away from the launch portal on Alpha Relay, with the lap timer, hull and fuel gauges and the circuit minimap." loading="eager" fetchpriority="high">
                        </a>
                        <% if (podium.length) { %>
                        <div class="home-stardust-board" aria-labelledby="stardust-lead-board">
                            <p id="stardust-lead-board" class="mono home-stardust-board-title">TIME TO BEAT · FULL NETWORK<% if (snap.generatedAt) { %> · <time datetime="<%= snap.generatedAt %>"><%= snap.generatedAt.slice(0, 10) %></time><% } %></p>
                            <ol>
                                <% podium.forEach((row) => { %><li><span class="mono"><%= two(row.rank) %></span><span><%= row.name %></span><span class="mono"><%= clock(row.timeMs) %></span></li><% }); %>
                            </ol>
                        </div>
                        <% } %>
                    </div>
                </section>
            <% } else if (frontmatter.hero_title) { %><%- include('hero', { frontmatter }) %><% } %>
            <section class="container game-spotlight" aria-labelledby="kingdoms-caravans-spotlight-title">
                <a class="game-spotlight-visual" href="<%= siteRoot %>kingdoms-caravans/" aria-label="Explore Kingdoms and Caravans">
                    <img src="<%= siteRoot %>assets/kingdoms-caravans/city.png" alt="Kingdoms and Caravans city preview with buildings, workers, and surrounding landscape" loading="lazy">
                </a>
                <div class="game-spotlight-copy">
                    <p class="section-label">PLAYABLE NOW · EARLY GAME BUILD</p>
                    <h2 id="kingdoms-caravans-spotlight-title">Kingdoms &amp; Caravans</h2>
                    <p class="section-desc">Build a growing city, move logs into planks, and keep food in reserve while two raider waves approach. It is an unfinished, unsigned Windows friend playtest focused on city supply, housing, and defense.</p>
                    <p><a class="btn btn-primary" href="<%= siteRoot %>kingdoms-caravans/">EXPLORE THE PLAYTEST</a> <a class="btn-noir" href="https://github.com/RoyGSlade/KingdomsAndCaravans/releases/tag/v0.3.2" rel="noopener noreferrer">RELEASE NOTES</a></p>
                </div>
            </section>
            <% if (betterFingers) { %>
                <section class="container home-betterfingers-spotlight" aria-labelledby="betterfingers-spotlight-title">
                    <a class="home-betterfingers-visual" href="<%= siteRoot %>projects/betterfingers/" aria-label="Explore BetterFingers">
                        <% if (betterFingersImage) { %><img src="<%= siteRoot %><%= betterFingersImage.publicPath %>" alt="<%= betterFingersImage.alt %>" loading="eager" fetchpriority="high"><% } %>
                        <span class="home-betterfingers-visual-label mono"><%= betterFingers.project.developmentLabel || 'PUBLIC ALPHA' %></span>
                    </a>
                    <div class="home-betterfingers-copy">
                        <p class="section-label">UNDERPLAIN · FEATURED RELEASE</p>
                        <h2 id="betterfingers-spotlight-title">BetterFingers</h2>
                        <p class="home-betterfingers-lede"><%= betterFingers.project.summary %></p>
                        <p class="home-betterfingers-proof">Speak locally. Review the result. Decide what leaves the app. Alpha 3 is available as a signed Windows installer with checksums and release evidence.</p>
                        <div class="home-betterfingers-actions">
                            <a class="btn btn-primary" href="<%= siteRoot %>projects/betterfingers/">EXPLORE BETTERFINGERS</a>
                            <% if (betterFingersRelease) { %><a class="btn-noir" href="<%= betterFingersRelease.url %>" rel="noopener noreferrer">SIGNED ALPHA 3 RELEASE</a><% } %>
                        </div>
                    </div>
                </section>
            <% } %>
            <%- content %>
            <div class="container home-support-ladder"><%- include('support-ladder', { variant: 'full' }) %></div>
            <% const featuredProjects = importedProjects.filter((item) => item.project.featured && item.id !== 'betterfingers'); %>
            <% const latestUpdates = importedProjects.flatMap((item) => item.publishedUpdates || []).sort((a, b) => b.date.localeCompare(a.date) || a.id.localeCompare(b.id)).slice(0, 5); %>
            <% if (featuredProjects.length) { %>
                <section class="container imported-home-section" aria-labelledby="imported-projects-title">
                    <div class="section-header"><div><h2 id="imported-projects-title" class="section-title section-label">MORE PROJECTS</h2><p class="section-desc">Other project-owned source packages with their current maturity visible.</p></div><a class="section-subtitle mono" href="<%= siteRoot %>projects/">ALL PROJECTS →</a></div>
                    <div class="project-grid"><% featuredProjects.forEach((item) => { %><article class="noir-card project-card imported-project-card"><div class="project-status project-status--<%= item.project.status %>"><%= item.project.status.replace(/-/g, ' ').toUpperCase() %></div><h3><a href="<%= siteRoot %>projects/<%= item.id %>/"><%= item.project.name %></a></h3><p><%= item.project.summary %></p><span class="mono imported-maturity">Maturity: <%= item.project.status %></span><a class="hero-link mono" href="<%= siteRoot %>projects/<%= item.id %>/">PROJECT DETAILS →</a></article><% }); %></div>
                </section>
            <% } %>
            <% if (latestUpdates.length) { %>
                <section class="container imported-home-section" aria-labelledby="latest-updates-title">
                    <div class="section-header"><div><h2 id="latest-updates-title" class="section-title section-label">LATEST PROJECT UPDATES</h2><p class="section-desc">Published updates from accepted project sources.</p></div></div>
                    <div class="imported-updates"><% latestUpdates.forEach((update) => { %><article class="noir-card imported-update"><time class="mono" datetime="<%= update.date %>"><%= update.date %></time><h3><a href="<%= siteRoot %>projects/<%= update.projectId %>/"><%= update.title %></a></h3><p><%= update.summary %></p><span class="mono section-subtitle"><%= update.projectName %> · <%= update.type %></span></article><% }); %></div>
                </section>
            <% } %>
        </main>
        <%- components.footer %>
    </div>
    <script src="<%= siteRoot %>scripts/script.js"></script>
    <script src="<%= siteRoot %>scripts/light-engine.js"></script>
    <script src="<%= siteRoot %>scripts/smoke.js"></script>
    <% if (data.weekly) { %><script type="module" src="<%= siteRoot %>scripts/stardust-weekly.js"></script><% } %>
</body>
</html>
